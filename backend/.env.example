# Copy this file to .env and fill in the values.

# Application (client) ID from the Azure app registration.
# Leave empty to run without sign-in (saving to an account is then disabled).
MSAL_CLIENT_ID=3958dc7d-4ad7-4bc8-b2a7-1deeb2dcf222

# Frontend URLs allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Where saved setups are stored.
#   Hosted Postgres (cloud):  postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#   Local file (development): leave empty, or sqlite:///randomizer.db
# This holds a password, so it lives only in .env and the host's settings, never in Git.
DATABASE_URL=
