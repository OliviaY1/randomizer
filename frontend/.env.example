# Copy this file to .env. In the cloud, set these in your host's settings.

# Backend URL
VITE_API_URL=http://localhost:8000

# Application (client) ID from the Azure app registration. Not a secret.
# Leave empty to run without sign-in (setups are then saved in this browser only).
VITE_MSAL_CLIENT_ID=3958dc7d-4ad7-4bc8-b2a7-1deeb2dcf222
